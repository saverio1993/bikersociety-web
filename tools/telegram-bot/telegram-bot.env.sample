# Copia este archivo a /opt/bikersociety/telegram-bot.env en el EC2 y rellena los valores.
# Luego: chmod 600 /opt/bikersociety/telegram-bot.env
# NO subas el archivo con valores reales a git.

# Token del bot (te lo da @BotFather al crear el bot)
TELEGRAM_TOKEN=

# Tu(s) ID(s) numérico(s) de Telegram, separados por coma. Obtén el tuyo con @userinfobot.
# Solo estos usuarios podrán usar el bot.
TELEGRAM_ALLOWED_IDS=

# Clave de la API de Anthropic (console.anthropic.com → API Keys). OJO: tiene costo por uso.
ANTHROPIC_API_KEY=

# (opcional) rutas/destinos — los valores por defecto suelen servir
BIKER_WEB_DIR=/var/www/bikersociety
BIKER_NOTIFY_URL=http://127.0.0.1:8090/notify
BIKER_NOTIFY_ORIGIN=https://bikersociety.duckdns.org
